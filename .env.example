# Postgres connection string (Neon via Vercel Storage sets this automatically)
DATABASE_URL=

# Random secret, at least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the hub, e.g. https://gentle-hub.vercel.app (http://localhost:3000 locally)
BETTER_AUTH_URL=http://localhost:3000

# Only these addresses can sign in (comma separated)
ALLOWED_EMAILS=berkcan@gentlegroup.de,medin@gentlegroup.de
